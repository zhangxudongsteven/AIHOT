# MacBook Pro: native PostgreSQL on the host; only the app runs in Compose.
# Copy to .data/macbook/deploy.env (chmod 600), then use:
# bash scripts/deploy-lan.sh --env-file .data/macbook/deploy.env deploy
# Reuses compose.lan.yml, project myhot-lan and volume myhot-lan_data.

# Docker Desktop containers reach the Mac host through this name, not localhost.
# Native host tools use 127.0.0.1 instead. Keep the password out of the URL.
DATABASE_URL=postgres://myhot@host.docker.internal:5432/myhot
PGPASSWORD=
DATABASE_POOL_MAX=4

# Initial host-only access. For LAN access, change BOTH to the Mac's actual LAN IP
# and an available port; host.docker.internal is not a reader-facing site address.
SITE_URL=http://localhost:3100
PORT=127.0.0.1:3100

# Fill independent deployment credentials; do not reuse example or test values.
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
AIHOT_RELEASE=dev
LOG_LEVEL=info

# compose.lan.yml forces these off and does not pass model/Feishu credentials.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
