# Copy to a private .env.lan on the server (chmod 600); never commit its filled-in copy.
# Used with compose.lan.yml only. No PostgreSQL container or example-source import is run.

# Existing LAN database. Keep the password out of the URL and in PGPASSWORD instead.
DATABASE_URL=postgres://myhot@172.16.0.17:5432/myhot
PGPASSWORD=
# Per backend process. The migration bootstrap requires at least 2 (MS-006).
DATABASE_POOL_MAX=4

# Website origin and Docker host-IP:host-port binding. Update both when changing the port.
SITE_URL=http://172.16.0.17:3000
PORT=172.16.0.17:3000

# Server-specific admin password (at least 12 characters) and two independent random secrets.
# Generate each value separately, for example with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Also used as the local Docker image tag; use letters, digits, dots, underscores and hyphens.
AIHOT_RELEASE=dev
LOG_LEVEL=info

# compose.lan.yml forces all of these off, irrespective of values in this file or the shell.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
# NODE_ENV=production enforces real authentication; AIHOT_ENVIRONMENT=development labels alerts.
# DEV_AUTH_*, model/provider keys, Feishu secrets and backup-store keys are not passed through.
